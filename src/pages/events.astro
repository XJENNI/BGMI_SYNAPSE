---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Events | MAVERICKS x SYNAPSE 2026" description="SYNAPSE MAMC 2026 - All Gaming Events. FIFA, Smash Karts, Stumble Guys, Clash Royale tournaments with exciting prizes." activePage="events">
  <section class="events-section">
    <div class="container">
      <h1 class="page-title">Synapse 2026 Events</h1>
      <p class="page-subtitle">Compete in multiple gaming tournaments and win exciting prizes!</p>
      <section class="admin-panel" aria-labelledby="adminPanelHeading">
        <div class="admin-panel-header">
          <h2 id="adminPanelHeading">Admin Event Management</h2>
          <a href="/admin/login" class="btn-register admin-link">Admin Login</a>
        </div>
        <p id="adminStatusMessage" class="admin-status-message" role="status" aria-live="polite">
          Admin login required to add new events.
        </p>

        <form id="adminEventForm" class="admin-event-form" novalidate hidden>
          <div class="admin-grid">
            <label for="eventTitle">Event Title</label>
            <input id="eventTitle" name="title" type="text" required maxlength="120" />

            <label for="eventDateTime">Date & Time</label>
            <input id="eventDateTime" name="dateTime" type="datetime-local" required />

            <label for="eventLocation">Location</label>
            <input id="eventLocation" name="location" type="text" required maxlength="120" />

            <label for="eventImageUrl">Image URL (Optional)</label>
            <input id="eventImageUrl" name="imageUrl" type="url" placeholder="https://example.com/banner.jpg" />
          </div>

          <label for="eventDescription">Description</label>
          <textarea id="eventDescription" name="description" rows="4" required maxlength="600"></textarea>

          <div class="admin-actions">
            <button type="submit" class="btn-register">Create Event</button>
            <button type="button" id="adminLogoutButton" class="btn-register admin-logout">Logout</button>
          </div>
          <p id="adminFormMessage" class="admin-status-message" role="alert" aria-live="assertive"></p>
        </form>
      </section>
      
      <div class="events-grid">
        <!-- FIFA Tournament Event -->
        <div class="event-card">
          <img src="/data/img/Fifa.jpg" alt="FIFA Tournament Poster" class="event-poster">
          <div class="event-content">
            <h3 class="event-title">⚽ FIFA Tournament</h3>
            <p class="event-mode">PlayStation Showdown</p>
            
            <div class="event-details">
