        <!-- Clash Royale Event -->
        <div class="event-card">
          <img src="/data/img/Clash_royale.jpg" alt="Clash Royale Tournament Poster" class="event-poster">
          <div class="event-content">
            <h3 class="event-title">⚔️ Clash Royale Tournament</h3>
            <p class="event-mode">Intercollege Championship</p>
            
            <div class="event-details">
              <div class="event-detail-item">
                <i class="fas fa-calendar-alt"></i>
                <span><strong>Dates:</strong> Feb 8 – 9, 2026</span>
              </div>
              <div class="event-detail-item">
                <i class="fas fa-clock"></i>
