              </div>
              <div class="event-detail-item">
                <i class="fas fa-map-marker-alt"></i>
                <span><strong>Mode:</strong> Online</span>
              </div>
              <div class="event-detail-item">
                <i class="fas fa-ticket-alt"></i>
                <span><strong>Entry Fee:</strong> ₹50</span>
              </div>
              <div class="event-detail-item">
                <i class="fas fa-trophy"></i>
