                <i class="fas fa-map-marker-alt"></i>
                <span><strong>Venue:</strong> Biochem Demo Room</span>
              </div>
              <div class="event-detail-item">
                <i class="fas fa-ticket-alt"></i>
                <span><strong>Entry Fee:</strong> ₹150 (Maulanians) / ₹200 (Non-Maulanians)</span>
              </div>
            </div>
            
            <div class="event-prize">
              <h4>🏅 Prize Pool: ₹2000</h4>
              <div class="prize-item">🥇 Winner: ₹1500</div>
              <div class="prize-item">🥈 Runner-up: ₹500</div>
