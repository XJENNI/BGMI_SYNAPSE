            <div class="event-actions">
              <a href="https://forms.gle/EnaBm7egRzgDtLeV6" target="_blank" rel="noopener noreferrer" class="btn-register">Register Now</a>
              <a href="https://chat.whatsapp.com/DKtZE89A1WrFVcfcA4oB0t" target="_blank" rel="noopener noreferrer" class="btn-register">Join WhatsApp</a>
            </div>
            
            <div class="event-contacts">
              <h5>📞 Contact</h5>
              <div class="contact-item">Dhruv Yadav: 8571971521</div>
              <div class="contact-item">Lakshya Singh: 9169332902</div>
              <div class="contact-item">Kshitiz: 8302115790</div>
              <div class="contact-item">Piyush: 8396936153</div>
            </div>
          </div>
        </div>

        <!-- Smash Karts Tournament Event -->
        <div class="event-card">
          <img src="/data/img/smash.jpg" alt="Smash Karts Tournament Poster" class="event-poster">
          <div class="event-content">
            <h3 class="event-title">🏎️ Smash Karts Tournament</h3>
            <p class="event-mode">Race to Glory!</p>
            
            <div class="event-details">
              <div class="event-detail-item">
