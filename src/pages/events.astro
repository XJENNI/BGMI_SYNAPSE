              </div>
            </div>
            
            <div class="event-prize">
              <h4>🏅 Prize Pool: ₹2000</h4>
              <div class="prize-item">🥇 1st Prize: ₹1500</div>
              <div class="prize-item">🥈 2nd Prize: ₹500</div>
            </div>
            
            <div class="event-actions">
              <a href="https://docs.google.com/forms/d/e/1FAIpQLScNrxwaUidv36CfDs2t1oer-appHxw_nB6hYmbavnu4TRVxQw/viewform?usp=dialog" target="_blank" rel="noopener noreferrer" class="btn-register">Register Now</a>
            </div>
            
            <div class="event-contacts">
              <h5>📞 Contact</h5>
              <div class="contact-item">Harsh Prajapati: 9354274406</div>
              <div class="contact-item">Parth Pandey: 9311308080</div>
            </div>
          </div>
        </div>

        <!-- Stumble Guys Event -->
        <div class="event-card">
          <img src="/data/img/Stumble_guys.JPG" alt="Stumble Guys Tournament Poster" class="event-poster">
          <div class="event-content">
            <h3 class="event-title">🎮 Stumble Guys Tournament</h3>
            <p class="event-mode">Stumble Your Way to Glory!</p>
            
            <div class="event-details">
              <div class="event-detail-item">
                <i class="fas fa-calendar-alt"></i>
                <span><strong>Date:</strong> Feb 11, 2026</span>
              </div>
              <div class="event-detail-item">
                <i class="fas fa-clock"></i>
                <span><strong>Time:</strong> 9:00 PM</span>
              </div>
              <div class="event-detail-item">
                <i class="fas fa-map-marker-alt"></i>
                <span><strong>Mode:</strong> Online - Play from home</span>
              </div>
              <div class="event-detail-item">
                <i class="fas fa-ticket-alt"></i>
                <span><strong>Entry Fee:</strong> ₹50 only</span>
              </div>
            </div>
            
            <div class="event-prize">
              <h4>🏅 Prize Pool</h4>
              <div class="prize-item">🥇 1st Prize: ₹1000</div>
              <div class="prize-item">🥈 2nd Prize: ₹500</div>
            </div>
            
            <div class="event-actions">
              <a href="https://docs.google.com/forms/d/e/1FAIpQLSc0aSYqazOQFkxZfNzzK4-XVOdiILAwCjDQtK-1TTaYyve8aA/viewform?usp=publish-editor" target="_blank" rel="noopener noreferrer" class="btn-register">Register Now</a>
            </div>
            
            <div class="event-contacts">
              <h5>📞 Contact</h5>
              <div class="contact-item">Sanyam Jain: 9817298150</div>
              <div class="contact-item">Sunny: 9996630595</div>
            </div>
          </div>
        </div>
      </div>

      <section class="custom-events-section" aria-labelledby="customEventsHeading">
        <h2 id="customEventsHeading" class="custom-events-title">Newly Added Events</h2>
        <div id="customEventsEmptyState" class="custom-events-empty">
          No additional events added yet.
        </div>
        <div id="customEventsGrid" class="events-grid custom-events-grid"></div>
      </section>
    </div>
  </section>
</Layout>

<script>
  const ADMIN_SESSION_KEY = 'bgmi_admin_session';
  const CUSTOM_EVENTS_KEY = 'bgmi_custom_events';

  const adminForm = document.getElementById('adminEventForm');
  const adminStatusMessage = document.getElementById('adminStatusMessage');
  const adminFormMessage = document.getElementById('adminFormMessage');
  const adminLogoutButton = document.getElementById('adminLogoutButton');
  const customEventsGrid = document.getElementById('customEventsGrid');
  const customEventsEmptyState = document.getElementById('customEventsEmptyState');

  function escapeHtml(value) {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function formatEventDate(dateValue) {
    const parsed = new Date(dateValue);
    if (Number.isNaN(parsed.getTime())) return 'Date TBD';
    return new Intl.DateTimeFormat('en-IN', {
      dateStyle: 'medium',
      timeStyle: 'short'
    }).format(parsed);
  }

  function getSavedEvents() {
    try {
      const saved = localStorage.getItem(CUSTOM_EVENTS_KEY);
      if (!saved) return [];
      const parsed = JSON.parse(saved);
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }

  function saveEvents(events) {
    localStorage.setItem(CUSTOM_EVENTS_KEY, JSON.stringify(events));
  }

  function renderEvents() {
    if (!customEventsGrid || !customEventsEmptyState) return;

    const events = getSavedEvents();
    if (!events.length) {
      customEventsGrid.innerHTML = '';
      customEventsEmptyState.style.display = 'block';
      return;
    }

    customEventsEmptyState.style.display = 'none';
    customEventsGrid.innerHTML = events
      .map((event) => {
        const imageMarkup = event.imageUrl
          ? `<img src="${escapeHtml(event.imageUrl)}" alt="${escapeHtml(event.title)} banner" class="event-poster">`
          : '';

        return `
          <article class="event-card">
            ${imageMarkup}
            <div class="event-content">
              <h3 class="event-title">${escapeHtml(event.title)}</h3>
              <p class="event-mode">Added by Admin</p>
              <div class="event-details">
                <div class="event-detail-item">
                  <i class="fas fa-calendar-alt"></i>
                  <span><strong>Date:</strong> ${escapeHtml(formatEventDate(event.dateTime))}</span>
                </div>
                <div class="event-detail-item">
                  <i class="fas fa-map-marker-alt"></i>
                  <span><strong>Location:</strong> ${escapeHtml(event.location)}</span>
                </div>
              </div>
              <p>${escapeHtml(event.description)}</p>
            </div>
          </article>
        `;
      })
      .join('');
  }

  function updateAdminState() {
    const isAdmin = sessionStorage.getItem(ADMIN_SESSION_KEY) === 'active';
    if (!adminForm || !adminStatusMessage) return;

    adminForm.hidden = !isAdmin;
    adminStatusMessage.textContent = isAdmin
      ? 'You are logged in as admin. Create events below.'
      : 'Admin login required to add new events.';
  }

  adminForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!adminFormMessage) return;

    const formData = new FormData(adminForm);
    const title = String(formData.get('title') ?? '').trim();
    const dateTime = String(formData.get('dateTime') ?? '').trim();
    const location = String(formData.get('location') ?? '').trim();
    const description = String(formData.get('description') ?? '').trim();
    const imageUrl = String(formData.get('imageUrl') ?? '').trim();

    if (!title || !dateTime || !location || !description) {
      adminFormMessage.textContent = 'Please fill all required fields.';
      adminFormMessage.classList.add('error');
      adminFormMessage.classList.remove('success');
      return;
    }

    if (imageUrl) {
      try {
        new URL(imageUrl);
      } catch {
        adminFormMessage.textContent = 'Please enter a valid image URL.';
        adminFormMessage.classList.add('error');
        adminFormMessage.classList.remove('success');
        return;
      }
    }

    const savedEvents = getSavedEvents();
    savedEvents.unshift({ title, dateTime, location, description, imageUrl });
    saveEvents(savedEvents);
    renderEvents();

    adminForm.reset();
    adminFormMessage.textContent = 'Event created successfully.';
    adminFormMessage.classList.add('success');
    adminFormMessage.classList.remove('error');
  });

  adminLogoutButton?.addEventListener('click', () => {
    sessionStorage.removeItem(ADMIN_SESSION_KEY);
    updateAdminState();
    if (adminFormMessage) {
      adminFormMessage.textContent = 'Logged out successfully.';
      adminFormMessage.classList.remove('error');
      adminFormMessage.classList.add('success');
    }
  });

  renderEvents();
  updateAdminState();
</script>

<style>
  .events-section {
    padding: 120px 20px 60px;
    min-height: 100vh;
  }
  
  .page-title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 1rem;
    text-transform: uppercase;
    background: linear-gradient(135deg, var(--accent-cyan), var(--accent-purple));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .page-subtitle {
    text-align: center;
    color: var(--text-secondary);
    margin-bottom: 60px;
    font-size: 1.1rem;
  }

  .admin-panel {
    border: 1px solid rgba(0, 240, 255, 0.35);
    background: rgba(0, 240, 255, 0.05);
    border-radius: 12px;
    padding: 22px;
    max-width: 960px;
    margin: 0 auto 40px;
  }

  .admin-panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .admin-panel-header h2 {
    margin: 0;
    color: var(--accent-cyan);
    font-family: var(--font-heading);
    text-transform: uppercase;
  }

  .admin-link {
    min-width: 160px;
    text-decoration: none;
  }

  .admin-status-message {
    color: var(--text-secondary);
    margin: 12px 0 0;
    min-height: 24px;
  }

  .admin-status-message.error {
    color: #ff6b6b;
  }

  .admin-status-message.success {
    color: #72f2b0;
  }

  .admin-event-form {
    margin-top: 14px;
  }

  .admin-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 16px;
    margin-bottom: 12px;
  }

  .admin-event-form label {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.9rem;
    align-self: end;
  }

  .admin-event-form input,
  .admin-event-form textarea {
    width: 100%;
    background: rgba(10, 10, 18, 0.95);
    color: var(--text-primary);
    border: 1px solid rgba(0, 240, 255, 0.35);
    border-radius: 6px;
    padding: 10px 12px;
    font: inherit;
  }

  .admin-event-form input:focus,
  .admin-event-form textarea:focus {
    outline: 2px solid rgba(0, 240, 255, 0.6);
    outline-offset: 2px;
  }

  .admin-actions {
    margin-top: 12px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .admin-logout {
    background: linear-gradient(135deg, rgba(188, 19, 254, 0.85), rgba(188, 19, 254, 0.65));
    color: #fff;
  }

  .custom-events-section {
    margin-top: 45px;
  }

  .custom-events-title {
    color: var(--accent-cyan);
    font-family: var(--font-heading);
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .custom-events-empty {
    color: var(--text-secondary);
    margin-bottom: 18px;
  }
  
  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 40px;
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .event-card {
    background: linear-gradient(135deg, rgba(15, 15, 26, 0.95), rgba(10, 10, 18, 0.95));
    border: 2px solid rgba(0, 240, 255, 0.2);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.4s ease;
    position: relative;
  }
  
  .event-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(0, 240, 255, 0.1), rgba(188, 19, 254, 0.1));
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  
  .event-card:hover {
    transform: translateY(-10px);
    border-color: var(--accent-cyan);
    box-shadow: 0 10px 40px rgba(0, 240, 255, 0.3);
  }
  
  .event-card:hover::before {
    opacity: 1;
  }
  
  .event-poster {
    width: 100%;
    height: 400px;
    object-fit: cover;
    display: block;
  }
  
  .event-content {
    padding: 25px;
  }
  
  .event-title {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 10px;
    color: var(--accent-cyan);
    text-transform: uppercase;
  }
  
  .event-mode {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 20px;
    font-style: italic;
  }
  
  .event-details {
    margin-bottom: 20px;
  }
  
  .event-detail-item {
    display: flex;
    align-items: flex-start;
    margin-bottom: 12px;
    font-size: 0.95rem;
  }
  
  .event-detail-item i {
    color: var(--accent-cyan);
    margin-right: 10px;
    margin-top: 3px;
    font-size: 1rem;
  }
  
  .event-prize {
    background: linear-gradient(135deg, rgba(255, 215, 0, 0.1), rgba(255, 215, 0, 0.05));
    border: 2px solid rgba(255, 215, 0, 0.3);
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 20px;
  }
  
  .event-prize h4 {
    color: var(--accent-gold);
    font-family: var(--font-heading);
    font-size: 1.1rem;
    margin-bottom: 8px;
  }
  
  .prize-item {
    color: var(--text-primary);
    margin-bottom: 5px;
  }
  
  .event-actions {
    display: flex;
    gap: 10px;
    margin-top: 20px;
  }
  
  .btn-register {
    flex: 1;
    padding: 12px 20px;
    background: linear-gradient(135deg, var(--accent-cyan), rgba(0, 240, 255, 0.7));
    color: var(--bg-primary);
    text-decoration: none;
    text-align: center;
    border-radius: 6px;
    font-weight: 700;
    font-family: var(--font-heading);
    text-transform: uppercase;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }
  
  .btn-register:hover {
    background: var(--accent-cyan);
    box-shadow: 0 5px 20px rgba(0, 240, 255, 0.4);
    transform: translateY(-2px);
  }
  
  .event-contacts {
    background: rgba(0, 240, 255, 0.05);
    border-radius: 6px;
    padding: 12px;
    margin-top: 15px;
    font-size: 0.9rem;
  }
  
  .event-contacts h5 {
    color: var(--accent-cyan);
    margin-bottom: 8px;
    font-family: var(--font-heading);
  }
  
  .contact-item {
    color: var(--text-secondary);
    margin-bottom: 3px;
  }
  
  @media (max-width: 768px) {
    .events-section {
      padding: 100px 15px 40px;
    }

    .admin-grid {
      grid-template-columns: 1fr;
    }
    
    .events-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    
    .event-poster {
      height: 250px;
    }
  }
</style>
