              <a href="https://chat.whatsapp.com/IHUoiKjzXoOKQbXO21zpqY" target="_blank" rel="noopener noreferrer" class="btn-register">Join WhatsApp</a>
            </div>
            
            <div class="event-contacts">
              <h5>📞 Contact</h5>
              <div class="contact-item">Utkarsh: 8278266600</div>
            </div>
            
            <div class="event-contacts" style="margin-top: 10px;">
              <h5>📱 Follow</h5>
              <div class="contact-item">Instagram: <a href="https://www.instagram.com/mavericks_mamc" target="_blank" rel="noopener noreferrer" style="color: var(--accent-cyan);">@mavericks_mamc</a></div>
